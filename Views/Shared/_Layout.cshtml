<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Staybnb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-custom.css" />
                            
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm sticky-top">

            <div class="container-fluid">
                <<a class="navbar-brand fw-bold fs-3"
                   asp-controller="Home"
                   asp-action="Index">
                    Staybnb
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Property"
                               asp-action="Index">
                                Properties
                            </a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Booking"
                                   asp-action="MyBookings">
                                    My Bookings
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Notification"
                               asp-action="Index">
                                Notifications
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                                asp-controller="Message"
                                asp-action="Inbox">
                                Inbox
                            </a>
                        </li>

                        @if (User.IsInRole("Host")
                                                || User.IsInRole("Admin")
                                                || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Property"
                                   asp-action="Create">
                                    Add Property
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Users">
                                    Admin Panel
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Host")
                                                || User.IsInRole("Admin")
                                                || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Property"
                                   asp-action="MyProperties">
                                    My Properties
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin")
                                                || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Property"
                                   asp-action="PendingProperties">
                                    Pending Properties
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Host")
                                                || User.IsInRole("Admin")
                                                || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Booking"
                                   asp-action="HostBookings">
                                    Property Bookings
                                </a>
                            </li>
                        }
                    </ul>
                    


                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>
    <div class="container py-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <p class="mb-0">
            © 2026 Staybnb.
            All rights reserved.
        </p>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
