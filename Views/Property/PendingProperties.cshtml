@model IEnumerable<Staybnb.Models.Property>

<h2 class="mb-4">
    Pending Property Approvals
</h2>

@if (!Model.Any())
{
    <p>No pending properties.</p>
}
else
{
    <div class="row">

        @foreach (var property in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm">

                    @if (property.Images != null
                                && property.Images.Any())
                    {
                        <img src="@property.Images.First().ImageUrl"
                             class="card-img-top"
                             style="height:250px;
                                                object-fit:cover;" />
                    }

                    <div class="card-body">

                        <h5>@property.Title</h5>

                        <p>@property.Description</p>

                        <p>
                            <strong>
                                R @property.PricePerNight / night
                            </strong>
                        </p>

                        <p>
                            @property.Address
                        </p>

                        <p>
                            Host:
                            @property.Host.UserName
                        </p>

                    </div>

                    <div class="card-footer bg-white">

                        <a asp-action="Approve"
                           asp-route-id="@property.Id"
                           class="btn btn-success w-100 mb-2">
                            Approve
                        </a>
                        <a asp-action="Reject"
                           asp-route-id="@property.Id"
                           class="btn btn-danger w-100 mb-2">
                            Reject / Delete
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@property.Id"
                           class="btn btn-dark w-100">
                            View Details
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}