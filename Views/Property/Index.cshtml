@model IEnumerable<Staybnb.Models.Property>

<h2 class="mb-4">Available Properties</h2>

<form method="get"
      class="row g-2 mb-4">

    <div class="col-md-3">
        <input type="text"
               name="searchString"
               class="form-control"
               placeholder="Search location or title..."
               value="@ViewBag.SearchString" />
    </div>

    <div class="col-md-2">
        <input type="number"
               name="maxPrice"
               class="form-control"
               placeholder="Max Price"
               value="@ViewBag.MaxPrice" />
    </div>

    <div class="col-md-2">
        <input type="number"
               name="guests"
               class="form-control"
               placeholder="Guests"
               value="@ViewBag.Guests" />
    </div>

    <div class="col-md-2">
        <select name="sortOrder"
                class="form-select">

            <option value="">
                Sort By
            </option>

            <option value="price_asc"
                    selected="@(ViewBag.SortOrder == "price_asc")">
                Price: Low to High
            </option>

            <option value="price_desc"
                    selected="@(ViewBag.SortOrder == "price_desc")">
                Price: High to Low
            </option>

        </select>
    </div>

    <div class="col-md-1">
        <button type="submit"
                class="btn btn-dark w-100">
            Search
        </button>
    </div>

    <div class="col-md-2">
        <a asp-action="Index"
           class="btn btn-secondary w-100">
            Clear
        </a>
    </div>

</form>


@if (!Model.Any())
{
    <p>No properties available.</p>
}
else
{
    <div class="row">

        @foreach (var property in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm">

                    @if (property.Images != null
                                && property.Images.Any())
                    {
                        <img src="@property.Images.First().ImageUrl"
                             class="card-img-top"
                             style="height:250px;
                                                object-fit:cover;" />
                    }
                    else
                    {
                        <img src="/images/no-image.jpg"
                             class="card-img-top"
                             style="height:250px;
                                                object-fit:cover;" />
                    }

                    <div class="card-body">

                        <h5 class="card-title">
                            @property.Title
                        </h5>

                        <p class="card-text">
                            @property.Description
                        </p>

                        <p>
                            <strong>
                                R @property.PricePerNight
                                / night
                            </strong>
                        </p>

                        <p>
                            @property.Address
                        </p>
                        <p>
                            Max Guests:
                            @property.MaxGuests
                        </p>
                        <p>

                            @if (property.Reviews.Any())
                            {
                                <span class="text-warning">
                                    ★
                                </span>

                                @property.AverageRating.ToString("0.0")

                                <small class="text-muted">
                                    (@property.Reviews.Count review(s))
                                </small>
                            }
                            else
                            {
                                <small class="text-muted">
                                    No reviews yet
                                </small>
                            }

                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <a asp-controller="Property"
                           asp-action="Details"
                           asp-route-id="@property.Id"
                           class="btn btn-dark w-100">
                            View Details
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}